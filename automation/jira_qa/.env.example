# Copy to automation/jira_qa/.env and replace every placeholder. Do not commit .env.
CLAWIQ_JIRA_WEBHOOK_SECRET=replace-with-a-long-random-secret
CLAWIQ_JIRA_BASE_URL=https://your-domain.atlassian.net
CLAWIQ_JIRA_EMAIL=you@example.com
CLAWIQ_JIRA_API_TOKEN=replace-with-a-jira-api-token
CLAWIQ_JIRA_QA_REVIEW_STATUS=В процессе проверки
# Optional: Jira custom-field ID holding acceptance criteria, for example customfield_12345.
# CLAWIQ_JIRA_ACCEPTANCE_CRITERIA_FIELD=customfield_12345
CLAWIQ_JIRA_QA_HOST=127.0.0.1
CLAWIQ_JIRA_QA_PORT=8787
CLAWIQ_JIRA_QA_MODEL=qwen3:14b
