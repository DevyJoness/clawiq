{
  "name": "clawiq-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first ClawIQ personal assistant desktop",
  "main": "apps/clawiq_desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test:desktop": "electron . --smoke-test",
    "build:windows": "electron-builder --win dir",
    "test": "node --test tests/clawiq_*.test.mjs"
  },
  "build": {
    "appId": "local.clawiq.desktop",
    "productName": "ClawIQ",
    "directories": {
      "output": "dist/clawiq"
    },
    "files": [
      "apps/clawiq_desktop/**",
      "core/**",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "author": "Artem"
}
